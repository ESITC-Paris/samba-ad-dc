# Go build outputs (entrypoint, e2e — from Phase 2 on)
/entrypoint/entrypoint
*.test
# go.work is committed (it only names the two modules); go.work.sum is
# not. It is a local resolution artifact of whichever toolchain last ran
# a workspace-wide command, and committing it would let the workspace
# override the modules' own go.sum files — the image build resolves
# entrypoint/ alone and would never see it.
go.work.sum
# Python bytecode cache: `python3 -m unittest scripts/catalog_test.py`
# imports the scripts as modules and CPython writes it next to them.
__pycache__/
# Local scratch
*.log
.DS_Store
# Local-only compose overrides
docker-compose.override.yml
# SDD controller scratch (plans' working artifacts, never committed)
.superpowers/
# Capability-bisection output. The dated report is what a run emits and
# what CI uploads as an artifact; the committed record of a run is the
# stable copy next to it (test/capbisect/results-<arch>.txt), so the dated
# file would only ever be a duplicate in the history.
/test/capbisect/capbisect-report-*.txt
